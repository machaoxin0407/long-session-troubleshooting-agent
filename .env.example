# Copy this file to .env and fill values locally. Never commit .env.

# API authentication
KAFU_API_TOKEN=replace-with-random-token

# service / tech classifier
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-provider-key
DEEPSEEK_BINARY_MODEL=deepseek-v4-flash

# main answer model (OpenAI-compatible)
SILICONFLOW_BASE_URL=https://your-openai-compatible-endpoint.example/v1
SILICONFLOW_API_KEY=replace-with-provider-key
SILICONFLOW_MODEL=replace-with-model-name

# retrieval
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=replace-with-provider-key
EMBEDDING_MODEL=Pro/BAAI/bge-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=replace-with-provider-key
RERANK_MODEL_ALIAS=BAAI/bge-reranker-v2-m3

# local video-scene retrieval
# Start with: ./video_embedding_service.sh start
VIDEO_RETRIEVAL_MODE=tri_hybrid
VIDEO_RUNTIME_PROFILE=production
# Production: fail a technical request instead of silently using fewer modalities.
VIDEO_REQUIRE_EXACT_MODE=1
VIDEO_MIN_CONTENT_BM25=2.0
VIDEO_DENSE_ENDPOINT=http://127.0.0.1:8091
VIDEO_DENSE_TIMEOUT_S=1.5
VIDEO_EMBEDDING_DEVICE=cuda:0
VIDEO_EMBEDDING_PORT=8091

# optional direct-video Qwen3-VL retrieval service
VIDEO_VISUAL_DENSE_ENDPOINT=http://127.0.0.1:8092
VIDEO_VISUAL_DENSE_TIMEOUT_S=2.0
VIDEO_VISUAL_CUDA_VISIBLE_DEVICES=1
VIDEO_VISUAL_EMBEDDING_PORT=8092

# asynchronous user-video diagnosis
USER_VIDEO_MAX_BYTES=209715200
USER_VIDEO_MAX_DURATION_S=60
USER_VIDEO_MAX_PIXELS=8294400
USER_VIDEO_ASYNC_MODE=spool
# OpenAI-compatible multimodal endpoint; leave empty for explicit insufficient_evidence.
USER_VIDEO_VLM_BASE_URL=
USER_VIDEO_VLM_API_KEY=
USER_VIDEO_VLM_MODEL=

# runtime
# Same-session memory only. Use a durable mounted path in containers.
CHAT_SESSION_DB_PATH=data/runtime/chat_sessions.sqlite3
CHAT_SESSION_HISTORY_LIMIT=6
CHAT_SESSION_TTL_S=3600
CHAT_SESSION_MAX_SESSIONS=500
CHAT_SESSION_RECENT_CHARS=6000
CHAT_SESSION_SUMMARY_CHARS=4000
CHAT_SESSION_EXCERPT_CHARS=800
CHAT_SESSION_RECALL_CHARS=2000
CHAT_SESSION_ARCHIVE_TURNS=200
CHAT_SESSION_ARCHIVE_CHARS=2000000
# Context uses conservative UTF-8 byte token estimates; current question is unchanged.
CHAT_SESSION_CONTEXT_TOKENS=6000
CHAT_SESSION_RECENT_TOKENS=2800
CHAT_SESSION_SUMMARY_TOKENS=1400
CHAT_SESSION_RECALL_TOKENS=800
CHAT_SESSION_SUMMARY_INPUT_TOKENS=16000
# Reuse the first configured answer route; empty model uses that route's model.
CHAT_SESSION_MODEL_SUMMARY=1
CHAT_SESSION_SUMMARY_MODEL=
CHAT_SESSION_SUMMARY_TIMEOUT_S=4
CHAT_SESSION_SUMMARY_MAX_TOKENS=1200
# Multi-layer same-session memory. 0 restores the single-summary context path.
CHAT_SESSION_TREE_ENABLED=1
CHAT_SESSION_TREE_RETRIEVAL=collapsed
CHAT_SESSION_TREE_CHUNK_TOKENS=800
CHAT_SESSION_TREE_MAX_LEAVES=512
CHAT_SESSION_TREE_BRANCH_SIZE=4
CHAT_SESSION_TREE_MAX_LEVELS=8
CHAT_SESSION_TREE_MODEL_CALLS=3
CHAT_SESSION_TREE_BUILD_TIMEOUT_S=8
CHAT_SESSION_TREE_TOP_K=3
# semantic uses existing EMBEDDING_* configuration; failure falls back locally.
CHAT_SESSION_TREE_EMBEDDING=lexical
CHAT_SESSION_TREE_EMBEDDING_TIMEOUT_S=4
CHAT_TIMEOUT_S=50
CHAT_MULTIMODAL_TIMEOUT_S=60
CHAT_MAX_IMAGES=3
RERANK_ENABLED=1
RETURN_PARENT_SECTION=1
# Request-wide conservative estimates; not an exact provider tokenizer.
LLM_CONTEXT_WINDOW_TOKENS=32768
LLM_CONTEXT_SAFETY_TOKENS=1024
LLM_IMAGE_TOKEN_RESERVE=8192

# Dedicated same-session embeddings; blank fields fall back to EMBEDDING_*.
# Keep manual retrieval embeddings compatible with the existing manual index.
CHAT_SESSION_TREE_EMBEDDING_BASE_URL=
CHAT_SESSION_TREE_EMBEDDING_API_KEY=
CHAT_SESSION_TREE_EMBEDDING_MODEL=
